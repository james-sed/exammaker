generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Authentication Models (Auth.js / NextAuth v5)
// -------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // Hashed password for the Credentials provider

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  quizzes        Quiz[]          @relation("QuizOwner")
  generationJobs GenerationJob[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// -------------------------------------------------------------
// Quiz Domain
// -------------------------------------------------------------

enum QuizStatus {
  DRAFT
  PUBLISHED
}

model Quiz {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("QuizOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  // Unguessable public identifier generated by the app (crypto.randomBytes).
  shareId     String  @unique

  status   QuizStatus @default(DRAFT)
  // { timeLimitMinutes: number | null, attemptLimit: number, shuffleOptions: boolean }
  settings Json       @default("{}")

  // Set when the first attempt starts. Question content is locked from then on.
  questionsLockedAt DateTime?
  publishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceFile SourceFile?
  questions  Question[]
  attempts   Attempt[]

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([status])
}

enum SourceStatus {
  UPLOADED
  EXTRACTING
  GENERATING
  READY
  FAILED
}

model SourceFile {
  id     String @id @default(cuid())
  quizId String @unique
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  originalName String
  mimeType     String
  sizeBytes    Int

  // Cleared as soon as extraction finishes; the binary is not retained.
  blobKey     String?
  status      SourceStatus @default(UPLOADED)
  errorReason String?      @db.Text

  // Sanitized text is retained so questions can be regenerated.
  // It is deleted with the quiz.
  extractedText String? @db.Text
  pageCount     Int?
  charCount     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generationJobs GenerationJob[]

  @@index([status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// Question Domain
// -------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  IDENTIFICATION
  ENUMERATION
}

model Question {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  type          QuestionType
  // Zod-validated discriminated union payload for the question type.
  payload       Json
  position      Int
  points        Float        @default(1)
  sourceExcerpt String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]

  @@unique([quizId, position])
  @@index([quizId])
}

// -------------------------------------------------------------
// Attempt & Grading Domain
// -------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the opaque token stored in the taker's httpOnly cookie.
  attemptToken String  @unique
  displayName  String?

  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  expiresAt   DateTime?
  status      AttemptStatus @default(IN_PROGRESS)

  score      Float @default(0)
  maxScore   Float @default(0)
  percentage Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]

  @@index([quizId])
  @@index([quizId, startedAt])
  @@index([status])
}

model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Zod-validated submission for the question type.
  payload      Json
  isCorrect    Boolean?
  scoreAwarded Float    @default(0)

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// -------------------------------------------------------------
// Generation Tracking
// -------------------------------------------------------------

enum GenerationStatus {
  QUEUED
  EXTRACTING
  GENERATING
  READY
  FAILED
}

// One row per generation request. Used for the 5-per-rolling-24h limit,
// the single-concurrent-generation limit, and token accounting.
model GenerationJob {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFileId String?
  sourceFile   SourceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  status GenerationStatus @default(QUEUED)

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  errorReason String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sourceFileId])
  @@index([status])
}
