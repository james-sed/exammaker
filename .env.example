# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/exammaker?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/exammaker?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Trust the request host when running `next start` outside Vercel. Vercel sets
# VERCEL=1, which already trusts the host.
AUTH_TRUST_HOST="true"

# Google OAuth (optional — omit both to hide "Continue with Google")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob — private store. Uploads fail with 503 until this is set.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# Vercel Cron — protects /api/jobs/janitor. Generate with the command in docs/README.md.
CRON_SECRET="replace-with-a-random-secret"
